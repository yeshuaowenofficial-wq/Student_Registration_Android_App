# Copy this file to ".env" and fill in your own values.
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=student_registration

# Long random string used to sign login tokens (change it!)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Code a lecturer must enter to create a lecturer account from the app
LECTURER_INVITE_CODE=MU-STAFF-2026
